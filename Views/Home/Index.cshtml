@{
    ViewData["Title"] = "Client Project Tracker";
}
<main>
  <header>
    <div>
      <h1>Client projects</h1>
      <p class="sub" id="summary">Loading…</p>
    </div>
    <div class="header-actions">
      <button type="button" class="theme-btn" id="themeBtn" aria-label="Switch to dark mode" title="Toggle dark mode">
        <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/></svg>
        <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
      <button class="primary" id="newBtn">New project</button>
    </div>
  </header>

  <div id="banner" role="alert"></div>

  <div class="toolbar">
    <input id="search" type="search" placeholder="Search by client or project" aria-label="Search projects">
    <select id="filterStatus" aria-label="Filter by status"><option value="">All statuses</option></select>
    <select id="filterPriority" aria-label="Filter by priority"><option value="">All priorities</option></select>
  </div>

  <div class="list" id="list" aria-live="polite"></div>
</main>

<dialog id="formDlg">
  <form class="dlg" id="form" novalidate>
    <h2 id="formTitle">New project</h2>
    <div id="formBanner" style="display:none" class="err"></div>
    <div class="two">
      <div class="field"><label for="clientName">Client name</label><input id="clientName" name="clientName" maxlength="100"><div class="err"></div></div>
      <div class="field"><label for="projectName">Project name</label><input id="projectName" name="projectName" maxlength="150"><div class="err"></div></div>
    </div>
    <div class="field"><label for="description">Description</label><textarea id="description" name="description" maxlength="2000"></textarea><div class="err"></div></div>
    <div class="two">
      <div class="field"><label for="status">Status</label><select id="status" name="status"></select><div class="err"></div></div>
      <div class="field"><label for="priority">Priority</label><select id="priority" name="priority"></select><div class="err"></div></div>
    </div>
    <div class="two">
      <div class="field"><label for="startDate">Start date</label><input type="date" id="startDate" name="startDate"><div class="err"></div></div>
      <div class="field"><label for="dueDate">Due date</label><input type="date" id="dueDate" name="dueDate"><div class="err"></div></div>
    </div>
    <div class="btns">
      <button type="button" id="cancelBtn">Cancel</button>
      <button type="submit" class="primary" id="saveBtn">Save project</button>
    </div>
  </form>
</dialog>

<dialog id="delDlg">
  <div class="dlg">
    <h2>Delete project?</h2>
    <p id="delText"></p>
    <div class="btns">
      <button id="delCancel">Keep project</button>
      <button class="danger" id="delConfirm">Delete project</button>
    </div>
  </div>
</dialog>

